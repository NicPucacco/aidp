# Copy to terraform.tfvars (gitignored) and fill in.
location    = "eastus2"
environment = "prod"

# Who can reach the Kubernetes API: office/VPN egress and CI runner ranges.
api_server_authorized_ip_ranges = ["203.0.113.0/24"]

# Entra group(s) that get cluster admin. Local accounts are disabled.
admin_group_object_ids = ["00000000-0000-0000-0000-000000000000"]

# kubernetes_version = "1.35"

# The zone the platform serves under; delegate it using the name_servers output.
base_domain = "platform.fernhill.example"
acme_email  = "platform-team@fernhill.example"
